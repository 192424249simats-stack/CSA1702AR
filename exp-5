      "source": [
        "# Python program to implement List operations\n",
        "\n",
        "# Creating a list\n",
        "list1 = [10, 20, 30, 40, 50]\n",
        "\n",
        "# 1. Nested List\n",
        "nested_list = [10, 20, [30, 40], 50]\n",
        "print(\"Nested List:\", nested_list)\n",
        "\n",
        "# 2. Length\n",
        "print(\"Length of List:\", len(list1))\n",
        "\n",
        "# 3. Concatenation\n",
        "list2 = [60, 70]\n",
        "print(\"Concatenated List:\", list1 + list2)\n",
        "\n",
        "# 4. Membership\n",
        "print(\"Is 30 present?\", 30 in list1)\n",
        "\n",
        "# 5. Iteration\n",
        "print(\"List elements:\")\n",
        "for item in list1:\n",
        "    print(item)\n",
        "\n",
        "# 6. Indexing\n",
        "print(\"Element at index 2:\", list1[2])\n",
        "\n",
        "# 7. Slicing\n",
        "print(\"Sliced List:\", list1[1:4])"
