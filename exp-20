      "source": [
        "# Python program to implement A* Algorithm\n",
        "\n",
        "import heapq\n",
        "\n",
        "graph = {\n",
        "    'A': {'B': 1, 'C': 4},\n",
        "    'B': {'C': 2, 'D': 5},\n",
        "    'C': {'D': 1},\n",
        "    'D': {}\n",
        "}\n",
        "\n",
        "# Heuristic values\n",
        "h = {\n",
        "    'A': 5,\n",
        "    'B': 4,\n",
        "    'C': 2,\n",
        "    'D': 0\n",
        "}\n",
        "\n",
        "def a_star(start, goal):\n",
        "    queue = [(h[start], 0, start, [start])]\n",
        "    visited = set()\n",
        "\n",
        "    while queue:\n",
        "        f, cost, node, path = heapq.heappop(queue)\n",
        "\n",
        "        if node in visited:\n",
        "            continue\n",
        "\n",
        "        visited.add(node)\n",
        "\n",
        "        if node == goal:\n",
        "            return path, cost\n",
        "\n",
        "        for neighbor, distance in graph[node].items():\n",
        "            new_cost = cost + distance\n",
        "            new_f = new_cost + h[neighbor]\n",
        "\n",
        "            heapq.heappush(\n",
        "                queue,\n",
        "                (new_f, new_cost, neighbor, path + [neighbor])\n",
        "            )\n",
        "\n",
        "    return None, None\n",
        "\n",
        "\n",
        "path, cost = a_star('A', 'D')\n",
        "\n",
        "print(\"Best Path:\", path)\n",
        "print(\"Cost:\", cost)"
      ]
    }
