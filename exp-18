      "source": [
        "# Python program to implement DFS\n",
        "\n",
        "graph = {\n",
        "    'A': ['B', 'C'],\n",
        "    'B': ['D', 'E'],\n",
        "    'C': ['F'],\n",
        "    'D': [],\n",
        "    'E': [],\n",
        "    'F': []\n",
        "}\n",
        "\n",
        "visited = set()\n",
        "\n",
        "def dfs(node):\n",
        "    if node not in visited:\n",
        "        print(node, end=\" \")\n",
        "        visited.add(node)\n",
        "\n",
        "        for neighbor in graph[node]:\n",
        "            dfs(neighbor)\n",
        "\n",
        "\n",
        "print(\"DFS Traversal:\")\n",
        "dfs('A')"
      ]
    }
