        "# Python program for Water Jug Problem\n",
        "\n",
        "from collections import deque\n",
        "\n",
        "def water_jug(capacity1, capacity2, target):\n",
        "\n",
        "    queue = deque()\n",
        "    visited = set()\n",
        "\n",
        "    # Initial state\n",
        "    queue.append((0, 0))\n",
        "    visited.add((0, 0))\n",
        "\n",
        "    while queue:\n",
        "        jug1, jug2 = queue.popleft()\n",
        "\n",
        "        # Check whether target is reached\n",
        "        if jug1 == target or jug2 == target:\n",
        "            print(\"Solution found:\")\n",
        "            print(\"Jug 1 =\", jug1, \"Jug 2 =\", jug2)\n",
        "            return\n",
        "\n",
        "        # Possible operations\n",
        "        states = [\n",
        "            (capacity1, jug2),  # Fill Jug 1\n",
        "            (jug1, capacity2),  # Fill Jug 2\n",
        "            (0, jug2),          # Empty Jug 1\n",
        "            (jug1, 0),          # Empty Jug 2\n",
        "        ]\n",
        "\n",
        "        # Pour Jug 1 into Jug 2\n",
        "        amount = min(jug1, capacity2 - jug2)\n",
        "        states.append((jug1 - amount, jug2 + amount))\n",
        "\n",
        "        # Pour Jug 2 into Jug 1\n",
        "        amount = min(jug2, capacity1 - jug1)\n",
        "        states.append((jug1 + amount, jug2 - amount))\n",
        "\n",
        "        # Add new states to the queue\n",
        "        for state in states:\n",
        "            if state not in visited:\n",
        "                visited.add(state)\n",
        "                queue.append(state)\n",
        "\n",
        "    print(\"No solution exists.\")\n",
        "\n",
        "\n",
        "# Input\n",
        "capacity1 = int(input(\"Enter capacity of Jug 1: \"))\n",
        "capacity2 = int(input(\"Enter capacity of Jug 2: \"))\n",
        "target = int(input(\"Enter target amount: \"))\n",
        "\n",
        "# Solve\n",
        "water_jug(capacity1, capacity2, target)"
      ]
