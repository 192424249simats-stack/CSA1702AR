      "source": [
        "# Python program to Transpose a Matrix\n",
        "\n",
        "# Define a matrix\n",
        "matrix = [\n",
        "    [1, 2, 3],\n",
        "    [4, 5, 6]\n",
        "]\n",
        "\n",
        "# Find transpose\n",
        "transpose = []\n",
        "\n",
        "for i in range(3):\n",
        "    row = []\n",
        "    for j in range(2):\n",
        "        row.append(matrix[j][i])\n",
        "    transpose.append(row)\n",
        "\n",
        "# Display the original matrix\n",
        "print(\"Original Matrix:\")\n",
        "for row in matrix:\n",
        "    print(row)\n",
        "\n",
        "# Display the transpose\n",
        "print(\"Transpose Matrix:\")\n",
        "for row in transpose:\n",
        "    print(row)"
      ]
    }
