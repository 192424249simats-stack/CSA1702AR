      "source": [
        "# Python program to Add Two Matrices\n",
        "\n",
        "# First matrix\n",
        "A = [\n",
        "    [1, 2],\n",
        "    [3, 4]\n",
        "]\n",
        "\n",
        "# Second matrix\n",
        "B = [\n",
        "    [5, 6],\n",
        "    [7, 8]\n",
        "]\n",
        "\n",
        "# Create an empty matrix for the result\n",
        "result = [\n",
        "    [0, 0],\n",
        "    [0, 0]\n",
        "]\n",
        "\n",
        "# Add the matrices\n",
        "for i in range(2):\n",
        "    for j in range(2):\n",
        "        result[i][j] = A[i][j] + B[i][j]\n",
        "\n",
        "# Display the result\n",
        "print(\"Resultant Matrix:\")\n",
        "\n",
        "for row in result:\n",
        "    print(row)"
      ]
